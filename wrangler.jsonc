{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muslim-community-accounting",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "muslim-community-accounting-staging",
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_APP_URL": "https://staging.bsmc.org.uk"
      }
    },
    "production": {
      "name": "muslim-community-accounting-production",
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_APP_URL": "https://finance.bsmc.org.uk"
      }
    }
  }
}
