{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muslim-community-accounting",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "masjid-db",
      "database_id": "f48aa1e9-1238-42a7-bdb2-8613fdbfcdc4"
    }
  ],
  "env": {
    "staging": {
      "name": "muslim-community-accounting-staging",
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_APP_URL": "https://staging.bsmc.org.uk"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "masjid-db-staging",
          "database_id": "84e4d16d-4a31-4338-94e5-02e79bdb80af"
        }
      ]
    },
    "production": {
      "name": "muslim-community-accounting-production",
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_APP_URL": "https://finance.bsmc.org.uk"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "masjid-db",
          "database_id": "f48aa1e9-1238-42a7-bdb2-8613fdbfcdc4"
        }
      ]
    }
  }
}
