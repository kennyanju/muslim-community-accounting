# ==============================================================================
# 🕌 Masjid Accounting - Environment Configuration Template
# Copy this file to .env.local for local development, or configure in Cloudflare Secrets:
#   npx wrangler secret put JWT_SECRET
#   npx wrangler secret put STRIPE_SECRET_KEY
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET
#   npx wrangler secret put RESEND_API_KEY
# ==============================================================================

# Node Environment
NODE_ENV=development

# Session Authentication Security
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Online Giving & Webhooks (Optional in development, required for online cards)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Receipt Delivery Service (Optional - defaults to console/mock log if unset)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=receipts@bristolmosque.org.uk

# Cloudflare D1 & Account IDs (For deployment with Wrangler)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
D1_DATABASE_ID=f48aa1e9-1238-42a7-bdb2-8613fdbfcdc4
