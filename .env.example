# ==============================================================================
# Masjid Accounting — Environment Configuration Example
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Backend secrets (SESSION_SECRET) must NEVER be prefixed with NEXT_PUBLIC_ or VITE_!
# - Prefixing a secret with NEXT_PUBLIC_ embeds it directly into the client-side JavaScript bundle.
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=production

# Server-Side HMAC Secret Key for cryptographic session tokens
# GENERATE IN PRODUCTION: openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_random_64_char_hex_secret_key_for_production_2026

# Session Maximum Age in Seconds (604800 = 7 days)
SESSION_MAX_AGE=604800

# Optional PostgreSQL / Supabase Connection URL (with SSL mode)
# DATABASE_URL=postgresql://postgres:password@db.example.com:5432/masjid_accounting?sslmode=require

# Optional Client Exception Monitoring DSN (Sentry / Highlight)
# NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0

# Public Canonical URL (Used for SEO and OpenGraph metadata)
NEXT_PUBLIC_APP_URL=https://your-masjid-domain.org.uk
